{
    "name": "becklyn/ddd-symfony-bridge",
    "description": "Symfony bridge for use with becklyn/ddd-core and becklyn/ddd-doctrine-bridge",
    "type": "symfony-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Christoph Hautzinger",
            "email": "ch@becklyn.com"
        },
        {
            "name": "Marko Vujnovic",
            "email": "mv@becklyn.com"
        }
    ],
    "require": {
        "becklyn/ddd-core": "^4.0",
        "becklyn/ddd-doctrine-bridge": "^3.0",
        "doctrine/doctrine-bundle": "^2.11 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.0",
        "php": ">=8.1",
        "symfony/config": "^6.4 || ^7.4",
        "symfony/dependency-injection": "^6.4 || ^7.4",
        "symfony/http-foundation": "^6.4 || ^7.4",
        "symfony/messenger": "^6.4 || ^7.4"
    },
    "require-dev": {
        "phpspec/prophecy-phpunit": "^2.0",
        "phpunit/phpunit": "^10.0 || ^11.0 || ^12.0"
    },
    "minimum-stability": "dev",
    "autoload": {
        "psr-4": {
            "Becklyn\\Ddd\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Becklyn\\Ddd\\Tests\\": "tests/"
        }
    }
}
